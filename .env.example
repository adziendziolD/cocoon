# All settings are optional – CoCoon works out of the box. API keys etc. are best set in the web UI.

# Address/port of the server. Keep 127.0.0.1 and use a reverse proxy (deploy/Caddyfile), VPN or SSH tunnel for remote access.
COCOON_HOST=127.0.0.1
COCOON_PORT=7420
# Sandbox backend: auto (default: Podman socket → Docker → bubblewrap on Linux), docker, podman or bwrap
# COCOON_DRIVER=auto
# Path to the Docker/Podman API socket (auto-detected if unset)
# DOCKER_SOCKET=
# Public URL shown in the login link (e.g. https://cocoon.example.com)
# COCOON_PUBLIC_URL=
# Where state, secrets and the admin token are stored (default: <repo>/.data)
# COCOON_DATA_DIR=./.data
# Optional fixed API token (in addition to tokens managed in the UI). Generate: openssl rand -hex 32
# COCOON_TOKEN=
# Optional JSON with initial settings for the very first start (see cocoon.config.example.json)
# COCOON_CONFIG=./cocoon.config.example.json
